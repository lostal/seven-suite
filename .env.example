# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://seven_suite:seven_suite_dev@localhost:5432/seven_suite

# ──────────────────────────────────────────────
# Auth.js
# ──────────────────────────────────────────────
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Keep independent from AUTH_SECRET.
MICROSOFT_TOKEN_ENCRYPTION_KEY=generate-a-different-32-byte-secret

# Development-only login. Keep disabled unless explicitly needed.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_PASSWORD=

# ──────────────────────────────────────────────
# Microsoft Entra ID (Azure AD)
# ──────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ──────────────────────────────────────────────
# Resend
# ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
